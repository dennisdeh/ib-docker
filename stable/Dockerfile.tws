##############################################################################
# Setup Stage: install apps
#
# This is a dedicated stage used as source for needed files.
#
##############################################################################

# hadolint global ignore=DL3008

# The gateway image this stage reads from. Both halves are build args so a
# build with nothing published yet - CI, or a version whose tag does not exist
# on ghcr.io yet - can point them at an image it has just built. See
# docs/DECISIONS.md.
ARG IB_GATEWAY_BASE_IMAGE=ghcr.io/dennisdeh/ib-gateway
ARG IB_VERSION=10.45.1j
FROM ${IB_GATEWAY_BASE_IMAGE}:${IB_VERSION} AS setup

WORKDIR /

##############################################################################
# Build Stage: build production image
##############################################################################

FROM lscr.io/linuxserver/rdesktop:ubuntu-xfce

ENV IB_GATEWAY_VERSION=10.45.1j
ENV IB_GATEWAY_RELEASE_CHANNEL=stable
ENV IBC_VERSION=3.24.2

# IB Gateway user constants
# IBC env vars
ENV TWS_MAJOR_VRSN=${IB_GATEWAY_VERSION}
ENV TWS_PATH=/opt/ibkr
ENV TWS_INI=jts.ini
ENV TWS_INI_TMPL=${TWS_INI}.tmpl
ENV IBC_PATH=/opt/ibc
ENV IBC_INI=${IBC_PATH}/config.ini
ENV IBC_INI_TMPL=${IBC_INI}.tmpl
ENV SCRIPT_PATH=/defaults
ENV GATEWAY_OR_TWS=tws
ENV NO_AT_BRIDGE=1

ARG DEBIAN_FRONTEND=noninteractive

# Retried: see the same loop in Dockerfile and docs/DECISIONS.md.
RUN for attempt in 1 2 3 4 5; do \
    apt-get update -y && \
    apt-get upgrade -y && \
    apt-get install --no-install-recommends --yes socat sshpass gettext-base \
      libnspr4 libnss3 libcrypto++8 xdg-utils xfce4-cpugraph-plugin \
      xfce4-netload-plugin xfce4-taskmanager xfce4-xkb-plugin xfce4-notes \
      gvfs gvfs-backends gvfs-fuse telnet && \
    break; \
    [ "$attempt" = 5 ] && exit 1; \
    echo ".> apt failed, dropping the index and retrying (attempt ${attempt})"; \
    rm -rf /var/lib/apt/lists/*; \
    sleep "$((attempt * 20))"; \
  done && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* # end

# Copy files
# /usr/local carries the JRE - see the same copy in Dockerfile and
# docs/DECISIONS.md. Without it the launcher points at a JVM that is not here.
COPY --from=setup /usr/local/ /usr/local/
COPY --chown=abc:abc --from=setup /home/ibgateway/Jts ${TWS_PATH}
COPY --chown=abc:abc --from=setup /home/ibgateway/ibc ${IBC_PATH}
COPY ./tws-scripts/start_session.sh /custom-services.d/start_session.sh
COPY ./tws-scripts/run_tws.sh ${SCRIPT_PATH}
COPY ./scripts/* ${SCRIPT_PATH}

# The desktop user must not be root-equivalent.
#
# The linuxserver base ships `%sudo ALL=(ALL:ALL) NOPASSWD: ALL` in /etc/sudoers
# and puts `abc` in gid 27, so `su -s /bin/bash abc -c 'sudo -n id'` returned
# uid 0 - the account the whole desktop and TWS run as could become root with no
# password. tests/unit/dockerfile.bats cannot see this: it greps source
# Dockerfiles and the grant is two layers down. See docs/OPEN_ITEMS.md #43.
#
# Removing the membership rather than the sudoers rule keeps root's own
# `sudo -EH -u abc` working - that is how tws-scripts/start_session.sh drops
# privileges, and sudo does not authenticate root. Verified against the base
# that nothing restores the membership at runtime: s6's init-adduser only
# does `usermod -u` / `groupmod -g` / `usermod -d` and chowns three paths, and
# nothing else under /etc/s6-overlay, /etc/cont-init.d or /custom-services.d
# mentions gpasswd, `usermod -aG` or the sudo group.
#
# The `if` tolerates a future base that no longer adds abc to the group; the
# assertion after it does not tolerate one that still does.
RUN case " $(id -nG abc) " in *" sudo "*) gpasswd -d abc sudo ;; esac && \
  case " $(id -nG abc) " in *" sudo "*) exit 1 ;; esac

# Fail the build if no JVM survived the copies above - see Dockerfile.
RUN java_bin="$(find /usr/local/i4j_jres ${TWS_PATH} -name java -type f -print -quit 2>/dev/null || true)" && \
  [ -n "${java_bin}" ] && "${java_bin}" -version

# labels
LABEL org.opencontainers.image.source=https://github.com/dennisdeh/ib-docker
LABEL org.opencontainers.image.url=https://github.com/dennisdeh/ib-docker/pkgs/container/tws-rdesktop
LABEL org.opencontainers.image.description="Docker image with XFCE, TWS & IBC"
LABEL org.opencontainers.image.licenses=MIT
LABEL org.opencontainers.image.version=${IB_GATEWAY_VERSION}-${IB_GATEWAY_RELEASE_CHANNEL}
