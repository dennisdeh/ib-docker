# Environment files: no real .env variant is ever tracked.
# .env-dist is the tracked template that records the key names.
.env
.env.*
*.env
!.env-dist
!*.env-dist
tws_settings/
ssh/
/config/
.python-version
# CLAUDE.md and CONTRIBUTING.md both tell you to create this to run
# `pre-commit`; it is a local tool install, never part of the tree.
.venv/
/*_password.txt
/pass/*
/init-scripts/*
/.idea/.gitignore
/.idea/ib-gateway-docker.iml
/.idea/modules.xml
/.idea/inspectionProfiles/profiles_settings.xml
/.idea/inspectionProfiles/Project_Default.xml
/.idea/vcs.xml
/keylock
/key.pem
/cert.pem
/data/
