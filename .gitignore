# Environment files: no real .env variant is ever tracked.
# .env-dist is the tracked template that records the key names.
.env
.env.*
*.env
!.env-dist
!*.env-dist
tws_settings/
ssh/
/config/
.python-version
/*_password.txt
/pass/*
/init-scripts/*
# Editor and agent state. Listing the whole directory, not the files inside it:
# the previous six /.idea/ entries named specific files, so anything the IDE
# added later - misc.xml, for one - showed up as untracked noise forever.
# .claude/ also holds worktrees/, which must never be committed.
.idea/
# .claude/*, not .claude/ - git cannot re-include a file whose parent directory
# is excluded, so the negation below would silently do nothing.
.claude/*
# A shared settings.json is checked in on purpose where a project has one, the
# same way .env-dist is; settings.local.json and worktrees/ stay ignored.
!.claude/settings.json
/keylock
/key.pem
/cert.pem
/data/
